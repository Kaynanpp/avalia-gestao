# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-avalia-gestao
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-avalia-gestao.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000
NEXT_PUBLIC_FIREBASE_APP_ID=demo

# Firebase Admin SDK (server-side only - NEVER expose these)
FIREBASE_ADMIN_PROJECT_ID=demo-avalia-gestao
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Avalia Gestão
NEXT_PUBLIC_COMPANY_BRAND=generic
NEXT_PUBLIC_COMPANY_NAME=Sua empresa

# Firebase Emulator (development only)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Security
PARTICIPATION_SECRET=generate_at_least_32_random_characters_and_keep_stable
# Optional dedicated key. If omitted, a domain-separated key is derived from PARTICIPATION_SECRET.
RATE_LIMIT_SECRET=
# Enable only behind a reverse proxy that replaces X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_IDENTIFICATION_MAX=10
RATE_LIMIT_IDENTIFICATION_WINDOW_SECONDS=900
RATE_LIMIT_IDENTIFICATION_BLOCK_SECONDS=600
RATE_LIMIT_SOURCE_MAX=60
RATE_LIMIT_SOURCE_WINDOW_SECONDS=300
RATE_LIMIT_SOURCE_BLOCK_SECONDS=300
RATE_LIMIT_CREDENTIAL_MAX=8
RATE_LIMIT_CREDENTIAL_WINDOW_SECONDS=900
RATE_LIMIT_CREDENTIAL_BLOCK_SECONDS=900
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=900
RATE_LIMIT_SENSITIVE_BLOCK_SECONDS=900
MAX_COMMENT_LENGTH=1000
MIN_EVALUATIONS_FOR_DISPLAY=5

# Rotação: manter segredos anteriores enquanto existirem ciclos/participações associados.
PARTICIPATION_PREVIOUS_SECRETS=

# Optional institutional website; leave empty until domain/channel approval.
PRODUCT_SITE_URL=
PRODUCT_INDEXING_ENABLED=false
PRODUCT_REPOSITORY_URL=
PRODUCT_APPLICATION_URL=
PRODUCT_DOCUMENTATION_URL=
PRODUCT_SUPPORT_EMAIL=
SITE_MODE=dedicated
