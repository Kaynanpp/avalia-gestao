# Copie para .env.pi no Raspberry e preencha os dados do projeto Firebase.
# Nunca versione .env.pi nem compartilhe a chave privada do Admin SDK.

# IP reservado do servidor; a aplicação só publicará a porta nesta interface.
SITE_BIND_IP=192.168.1.50
# Porta de acesso HTTP do AvaliaGestão.
SITE_APP_PORT=8081

# URL que os dispositivos da produção usarão. Em publicação externa, use HTTPS.
NEXT_PUBLIC_APP_URL=http://192.168.1.50:8081
NEXT_PUBLIC_APP_NAME=Avalia Gestão
NEXT_PUBLIC_COMPANY_BRAND=generic
NEXT_PUBLIC_COMPANY_NAME=Sua empresa

# Firebase Web config (pública; usada pelo SDK no navegador durante o build).
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Firebase Admin SDK (privado; usado somente no servidor).
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Regras funcionais do sistema.
PARTICIPATION_SECRET=gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Opcional: use outro segredo de 32+ caracteres. Vazio deriva uma chave do segredo acima.
RATE_LIMIT_SECRET=
# Mantenha false em acesso direto. Use true somente atrás de proxy que substitui X-Forwarded-*.
TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_IDENTIFICATION_MAX=10
RATE_LIMIT_IDENTIFICATION_WINDOW_SECONDS=900
RATE_LIMIT_IDENTIFICATION_BLOCK_SECONDS=600
RATE_LIMIT_SOURCE_MAX=60
RATE_LIMIT_SOURCE_WINDOW_SECONDS=300
RATE_LIMIT_SOURCE_BLOCK_SECONDS=300
RATE_LIMIT_CREDENTIAL_MAX=8
RATE_LIMIT_CREDENTIAL_WINDOW_SECONDS=900
RATE_LIMIT_CREDENTIAL_BLOCK_SECONDS=900
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=900
RATE_LIMIT_SENSITIVE_BLOCK_SECONDS=900
MAX_COMMENT_LENGTH=1000
MIN_EVALUATIONS_FOR_DISPLAY=5



# Segredos anteriores separados por vírgula; nunca remover sem plano de retenção.
PARTICIPATION_PREVIOUS_SECRETS=

# Site institucional: somente após aprovação de domínio/canal/publicação.
PRODUCT_SITE_URL=
PRODUCT_INDEXING_ENABLED=false
PRODUCT_REPOSITORY_URL=
PRODUCT_APPLICATION_URL=
PRODUCT_DOCUMENTATION_URL=
PRODUCT_SUPPORT_EMAIL=
SITE_MODE=dedicated
