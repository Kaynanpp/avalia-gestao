{
  "name": "avalia-gestao",
  "version": "1.0.0-rc.2",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.cjs",
    "test:integration": "node scripts/run-integration.cjs",
    "test:recovery": "node scripts/run-integration.cjs --recovery",
    "docs:public": "node scripts/generate-public-docs.cjs",
