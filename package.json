    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.cjs",
    "emulators": "npx firebase emulators:start",
    "seed": "ts-node --project tsconfig.seed.json scripts/seed.ts",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "production:migrate": "node scripts/migrate-production.cjs",
    "config:check": "node scripts/check-environment.cjs"
  },
